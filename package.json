{
  "name": "please-exe",
  "version": "0.1.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "verify": "npm run check && npm test && npm run build",
    "preview": "node scripts/preview.mjs",
    "relay": "node --env-file-if-exists=.env dist/server/main.js",
    "package": "node scripts/package.mjs",
    "prepackage": "npm run build"
  },
  "license": "MIT",
  "description": "A private tone coach for your very expensive autocomplete.",
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
