# Copy to .env (gitignored). Keep permissions private. Never share or commit keys.
JEV_API_KEY=
# Generate a NEW separate token: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
PLEASE_RELAY_TOKEN=
# Copy the exact origin shown in extension Settings after installation.
PLEASE_ALLOWED_ORIGINS=chrome-extension://REPLACE_WITH_YOUR_EXTENSION_ID
PLEASE_PER_MINUTE=20
PLEASE_PER_DAY=200
PLEASE_BIND=127.0.0.1
PORT=3210
